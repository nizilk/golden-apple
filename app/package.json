{
  "name": "golden-apple",
  "version": "1.0.2",
  "description": "GoldenApple local application",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.goldenapple.app",
    "productName": "Golden Apple",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "shortcutName": "Golden Apple",
      "include": "build/installer.nsh",
      "warningsAsErrors": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
